  <!-- =====================================================================
       插件运行时依赖统一复制到宿主根目录（AppDomain.BaseDirectory = Main\bin\Debug\）。
       PluginManager 直接 LoadFrom Plugins 源目录（2026-09-02 起不再使用 Shadow 副本），
       CLR 对 LoadFrom 加载的程序集的依赖解析会回落到宿主基目录；因此依赖放根目录即可被解析，
       Plugins 目录保持只放插件本体（依赖 DLL 不复制进 Plugins）。
       System.* 与宿主已提供的程序集（App 依赖传递）不在此清单中，避免覆盖宿主版本。
       ===================================================================== -->
  <Target Name="CopySecsRuntimeDepsToHostBin" AfterTargets="Build">
    <ItemGroup>
      <_SecsRuntimeDeps Include="..\packages\CommunityToolkit.HighPerformance.8.2.2\lib\netstandard2.0\CommunityToolkit.HighPerformance.dll" />
      <_SecsRuntimeDeps Include="..\packages\Microsoft.Bcl.AsyncInterfaces.8.0.0\lib\netstandard2.0\Microsoft.Bcl.AsyncInterfaces.dll" />
      <_SecsRuntimeDeps Include="..\packages\Microsoft.Bcl.HashCode.1.1.1\lib\net461\Microsoft.Bcl.HashCode.dll" />
      <_SecsRuntimeDeps Include="..\packages\Microsoft.Extensions.Configuration.Abstractions.8.0.0\lib\netstandard2.0\Microsoft.Extensions.Configuration.Abstractions.dll" />
      <_SecsRuntimeDeps Include="..\packages\Microsoft.Extensions.Configuration.Binder.8.0.0\lib\netstandard2.0\Microsoft.Extensions.Configuration.Binder.dll" />
      <_SecsRuntimeDeps Include="..\packages\Microsoft.Extensions.DependencyInjection.Abstractions.8.0.0\lib\netstandard2.0\Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
      <_SecsRuntimeDeps Include="..\packages\Microsoft.Extensions.Options.8.0.0\lib\netstandard2.0\Microsoft.Extensions.Options.dll" />
      <_SecsRuntimeDeps Include="..\packages\Microsoft.Extensions.Options.ConfigurationExtensions.8.0.0\lib\netstandard2.0\Microsoft.Extensions.Options.ConfigurationExtensions.dll" />
      <_SecsRuntimeDeps Include="..\packages\Microsoft.Extensions.Primitives.8.0.0\lib\netstandard2.0\Microsoft.Extensions.Primitives.dll" />
      <_SecsRuntimeDeps Include="..\packages\PooledAwait.1.0.49\lib\net461\PooledAwait.dll" />
      <_SecsRuntimeDeps Include="..\packages\Secs4Net.2.4.3\lib\netstandard2.0\Secs4Net.dll" />
      <_SecsRuntimeDeps Include="..\packages\Secs4Net.Sml.2.4.3\lib\netstandard2.0\Secs4Net.Sml.dll" />
      <_SecsRuntimeDeps Include="..\packages\System.ComponentModel.Annotations.5.0.0\lib\net461\System.ComponentModel.Annotations.dll" />
      <_SecsRuntimeDeps Include="..\packages\System.IO.Pipelines.8.0.0\lib\netstandard2.0\System.IO.Pipelines.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_SecsRuntimeDeps)" DestinationFolder="..\Main\bin\$(Configuration)\" SkipUnchangedFiles="true" />
  </Target>
  <!-- =====================================================================
       构建后清理输出目录（Plugins）中 netstandard2.0 外观程序集（System.*.dll、
       netstandard.dll、Microsoft.Win32.Primitives.dll 等）。这些是 .NET SDK
       构建对 netstandard 引用的副产物，并非插件运行时依赖（宿主根目录的
       netstandard.dll 已提供类型转发），保留会污染插件目录。插件本体
       （Plugin_*.dll）与契约 Plugin.Abstractions.dll 不受影响。
       ===================================================================== -->
  <Target Name="CleanSecsPluginOutputFacades" AfterTargets="Build">
    <ItemGroup>
      <_FacadeToRemove Include="$(OutDir)netstandard.dll" />
      <_FacadeToRemove Include="$(OutDir)Microsoft.Win32.Primitives.dll" />
      <_FacadeToRemove Include="$(OutDir)System.*.dll" />
    </ItemGroup>
    <Delete Files="@(_FacadeToRemove)" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>