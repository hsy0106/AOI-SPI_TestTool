<?xml version="1.0"?>
<root>
  <Name>AOI规范化模板</Name>
  <TemplateParam>
    <Setting Code="UserName" Name="用户名称" IsUserEdit="1">UserName</Setting>
    <Setting Code="MachineID" Name="设备编号" IsUserEdit="1">MachineID</Setting>
    <Setting Code="MachineName" Name="设备名称" IsUserEdit="1">AOITEST-INJECT</Setting>
    <Setting Code="SoftName" Name="软件名称" IsUserEdit="1">SoftName</Setting>
    <Setting Code="SoftVersion" Name="软件版本" IsUserEdit="1">SoftVersion</Setting>
    <Setting Code="Operator" Name="操作者" IsUserEdit="1">Operator</Setting>
    <Setting Code="LineName1" Name="线体号1">LineName1</Setting>
    <Setting Code="LineName2" Name="线体号2">LineName2</Setting>
    <Setting Code="IP" Name="设备IP" IsUserEdit="1">192.168.0.1</Setting>
    <Setting Code="Mac" Name="Mac地址" IsUserEdit="1">18-31-BF-07-EA-5E</Setting>
    <Setting Code="WorkStation1" Name="工作中心1" IsUserEdit="1">WorkStation1</Setting>
    <Setting Code="WorkStation2" Name="工作中心2" IsUserEdit="1">WorkStation2</Setting>
    <Setting Code="Side1" Name="板面1" IsUserEdit="1">A</Setting>
    <Setting Code="Side2" Name="板面2" IsUserEdit="1">B</Setting>
    <Setting Code="WorkNo1" Name="工单号1">WorkNo1</Setting>
    <Setting Code="WorkNo2" Name="工单号2">WorkNo2</Setting>
    <Setting Code="IsCallSwitchJobInterface" Name="是否调用切换Job返回接口" IsUserEdit="1">1</Setting>
    <Setting Code="IsExportSpcFile" Name="是否输出Spc文件" IsUserEdit="1">0</Setting>
    <Setting Code="IsEnableWebApiServer" Name="是否启动WebApiServer监听" IsUserEdit="1">0</Setting>
    <Setting Code="WebApiServerUrl" Name="监听WebApiServer地址" IsUserEdit="1">http://+:7070/</Setting>
    <Setting Code="InterfaceUrl" Name="接口地址" IsUserEdit="1">http://127.0.0.1:7070/</Setting>
    <Setting Code="Timeout" Name="网络超时时间(S)" IsUserEdit="1">4</Setting>
    <Setting Code="IsEnableLoginCheck" Name="是否调用登录检测接口" IsUserEdit="1">1</Setting>
    <Setting Code="IsEnableBarcodeCheck" Name="是否调用条码检测接口" IsUserEdit="1">1</Setting>
    <Setting Code="IsSingleBarcode" Name="是否只有主条码" IsUserEdit="1">1</Setting>
    <Setting Code="IsSaveCSV" Name="是否保存CSV数据" IsUserEdit="1">1</Setting>
    <Setting Code="IsSaveNGComponent" Name="保存NG元件" IsUserEdit="1">1</Setting>
    <Setting Code="IsSavePassComponent" Name="保存Pass元件" IsUserEdit="1">0</Setting>
    <Setting Code="IsSaveGoodComponent" Name="保存Good元件" IsUserEdit="1">0</Setting>
    <Setting Code="IsSendData" Name="是否发送数据" IsUserEdit="1">1</Setting>
    <Setting Code="ExportDataPathLane1" Name="1轨文件路径" IsUserEdit="1">D:\EYAOI\DataExport\MES\1</Setting>
    <Setting Code="ExportDataPathLane2" Name="2轨文件路径" IsUserEdit="1">D:\EYAOI\DataExport\MES\2</Setting>
    <Setting Code="IsPostServiceGetBarCode" Name="是否请求服务器获取条码" IsUserEdit="1">0</Setting>
    <Setting Code="IsReadBadMarkFileGetBarCode" Name="是否读取BadMark文件获取条码" IsUserEdit="1">0</Setting>
    <Setting Code="IsReadBadMarkFile" Name="是否读取BadMark文件" IsUserEdit="1">0</Setting>
    <Setting Code="IsExportBadMarkFile" Name="是否导出BadMark文件" IsUserEdit="1">0</Setting>
    <Setting Code="IsNgAsBadMark" Name="是否Ng作为BadMark" IsUserEdit="1">0</Setting>
    <Setting Code="ReadBadMarkFilePathLane1" Name="1轨读取BadMark文件路径" IsUserEdit="1">D:\EYAOI\DataExport\BadMarkRead\1</Setting>
    <Setting Code="ReadBadMarkFilePathLane2" Name="2轨读取BadMark文件路径" IsUserEdit="1">D:\EYAOI\DataExport\BadMarkRead\2</Setting>
    <Setting Code="ExportBadMarkFilePathLane1" Name="1轨导出BadMark文件路径" IsUserEdit="1">D:\EYAOI\DataExport\BadMarkExport\1</Setting>
    <Setting Code="ExportBadMarkFilePathLane2" Name="2轨导出BadMark文件路径" IsUserEdit="1">D:\EYAOI\DataExport\BadMarkExport\2</Setting>
    <Setting Code="ILWholeImagePath1" Name="1轨中间层整板图路径" IsUserEdit="1"></Setting>
    <Setting Code="ILWholeImagePath2" Name="2轨中间层整板图路径" IsUserEdit="1"></Setting>
    <Setting Code="ExportDataPathRule-1" Name="1轨数据文件路径规则">D:\EYAOI\DataExport\MES\{BarCode}.txt</Setting>
    <Setting Code="ExportDataPathRule-2" Name="2轨数据文件路径规则">D:\EYAOI\DataExport\MES\{BarCode}.txt</Setting>
    <Setting Code="ImageRootDir" Name="图片根目录路径">F:\DataExport</Setting>
    <Setting Code="ImageExportRootDir" Name="图片导出根目录路径" IsUserEdit="1">F:\DotNET</Setting>
    <Setting Code="IsUseImageCustomDir" Name="是否启用自定义图片规则">0</Setting>
    <Setting Code="IsSaveGood" Name="是否保存Good元件图片">0</Setting>
    <Setting Code="IsSavePass" Name="是否保存Pass元件图片">0</Setting>
    <Setting Code="IsSaveNG" Name="是否保存NG元件图片">0</Setting>
    <Setting Code="ImageCustomDir" Name="1轨自定义图片路径">D:\EYAOI\Data</Setting>
    <Setting Code="ImageCustomDir2" Name="2轨自定义图片路径">D:\EYAOI\Data</Setting>
    <Setting Code="ImageSaveRule" Name="1轨自定义图片规则">{StartTime-yyyy}\{StartTime-MM}\{StartTime-dd}\{BoardBarCode}-{StartTime-yyyyMMddHHmmss}\{ComponentResult}\{ComponentPartDesignate}-{ArrayBarCodeOrID}-{JobName}-{StartTime-yyyyMMddHHmmss}</Setting>
    <Setting Code="ImageSaveRule2" Name="2轨自定义图片规则">{StartTime-yyyy}\{StartTime-MM}\{StartTime-dd}\{BoardBarCode}-{StartTime-yyyyMMddHHmmss}\{ComponentResult}\{ComponentPartDesignate}-{ArrayBarCodeOrID}-{JobName}-{StartTime-yyyyMMddHHmmss}</Setting>
    <Setting Code="IsFTPSaveImage" Name="是否启用FTP上传图片">0</Setting>
    <Setting Code="FtpHost" Name="FTP主机IP">127.0.0.1</Setting>
    <Setting Code="FtpPort" Name="FTP主机端口">21</Setting>
    <Setting Code="FtpUserName" Name="FTP用户名">UserName</Setting>
    <Setting Code="FtpPassword" Name="FTP密码">Password</Setting>
    <Setting Code="FTPImagePath" Name="FTP图片路径">/AOI</Setting>
    <Setting Code="CustomLogPath" Name="自定义日志路径" IsUserEdit="1">D:\EYAOI\Logger\IL\PDM</Setting>
    <Setting Code="IsFillWindowList" Name="是否填充WindowList" IsUserEdit="1">0</Setting>
    <Setting Code="IsFillAlgTestItemList" Name="IsFillAlgTestItemList" IsUserEdit="1">0</Setting>
  </TemplateParam>
</root>
